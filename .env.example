# -----------------------------------------------------------------------------
# Carnival of Clothes by Nandini - Environment Variables Template
# -----------------------------------------------------------------------------

# Site URL
NEXT_PUBLIC_SITE_URL=https://www.carnivalofclothes.com

# Supabase (Database & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
DATABASE_URL=
DIRECT_URL=postgresql://postgres.your-project:password@pooler.supabase.com:5432/postgres

# Admin Authentication
ADMIN_ACCESS_KEY=your_admin_secret_passcode
ADMIN_COOKIE_SECRET=your_32_character_random_secret

# Razorpay Payments (Standard Checkout & Webhook)
RAZORPAY_KEY_ID=rzp_live_or_test_xxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_or_test_xxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Cloudinary (Product & Media Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Gemini AI (Product Description Generator)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Resend Email (Transactional Receipts & Alerts - Optional)
RESEND_API_KEY=re_xxxxxxx
ORDER_FROM_EMAIL=orders@carnivalofclothes.com
STORE_NOTIFICATION_EMAIL=nandini@carnivalofclothes.com

# WhatsApp Cloud API (Automated Order Confirmations - Optional)
WHATSAPP_API_TOKEN=your_whatsapp_meta_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# Shipping & Logistics
SHIPPING_PROVIDER=manual
